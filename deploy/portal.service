[Unit]
Description=Portal
After=network.target concentrator.service

[Service]
ExecStart=/home/mzh/Projects/monolith/portal/bin/portal
WorkingDirectory=/home/mzh/Projects/monolith/portal
User=mzh
# 443 and 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
